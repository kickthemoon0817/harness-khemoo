# Copy to config/harness.env and edit. Sourced by bin/tick.sh.

# --- required ---------------------------------------------------------------
# Absolute path to the git checkout each tick runs in. Ticks must not edit it
# directly; they create worktrees from it.
TARGET_REPO=/path/to/your/repo

# --- GitHub -----------------------------------------------------------------
# owner/name. Leave empty to let gh infer it from TARGET_REPO's remote.
GH_REPO=
# Only issues carrying ISSUE_LABEL are ever worked. WIP_LABEL marks a claim.
ISSUE_LABEL=ai
WIP_LABEL=ai:wip

# --- pool sizing ------------------------------------------------------------
# Upper bound on concurrent ticks. The allocator lowers it as usage climbs:
#   <55%: MAX_SLOTS   <70%: 6   <80%: 4   <85%: 3   <90%: 2   <95%: 1   else 0
MAX_SLOTS=8
# Seconds between spawning each runner, so parallel ticks do not claim the same issue.
STAGGER_SECONDS=8
# Minimum seconds between heartbeat ticks when the queue is empty.
HEARTBEAT_INTERVAL=1800

# --- usage telemetry --------------------------------------------------------
# JSON written by USAGE_FETCH; must contain timestamp, fiveHourPercent, weeklyPercent.
# If the file is missing the harness still runs, capped at 3 slots.
USAGE_CACHE=$HOME/.claude/usage-cache.json
USAGE_FETCH=$HOME/.claude/scripts/usage-fetch.sh
USAGE_MAX_AGE=1800        # older than this: treat as unknown
USAGE_REFRESH_AFTER=120   # younger than this: skip the refresh call

# --- runtime ----------------------------------------------------------------
CLAUDE_BIN=claude
# Ticks are unattended, so they cannot answer permission prompts. Narrow this if
# your setup allows a settings allowlist instead.
CLAUDE_FLAGS=--dangerously-skip-permissions
# State (logs, locks) lives outside the target repo so it never pollutes a diff.
# HARNESS_STATE=$HARNESS_HOME/state
LOG_RETENTION=200
