# Copy to $HARNESS_INSTANCE_DIR/harness.env (default instance/harness.env) and edit.
# Sourced by bin/tick.sh, so it is shell: quote values with spaces. HARNESS_INSTANCE_DIR and
# HARNESS_ENV are read from the environment only, never from this file.

# --- required ---------------------------------------------------------------
# The checkout ticks start in; they never edit it, only create worktrees from it.
TARGET_REPO=/path/to/checkout
# Where ticks create their worktrees, outside the checkout so they never show in its status.
WORKTREE_ROOT=/path/to/worktrees

# --- GitHub -----------------------------------------------------------------
# owner/name ([HOST/]OWNER/NAME off github.com); empty derives it from TARGET_REPO's origin remote,
# and `tick.sh check` fails when that remote names none.
GH_REPO=
# A token for gh when cron has no gh login; the cron scripts and the dashboard pass it to gh only.
# GH_TOKEN=
# Only issues carrying it are ever worked.
ISSUE_LABEL=ai
# Marks an issue a tick has claimed.
WIP_LABEL=ai:wip
# Marks an issue whose verified PR waits for the merge slot.
READY_LABEL=ai:ready
# Parks an issue until the owner signs it off; no tick claims it.
SIGNOFF_LABEL=ai:signoff
# Parks an issue until an operator answers it; no tick claims it.
OPERATOR_LABEL=ai:operator
# Takes an issue before any older fresh one.
FIRST_LABEL=ai:first
# Counts an issue only when nothing else is claimable.
LOW_LABEL=ai:low
# Gives an issue the long tick budget; only the operator sets it.
LONG_LABEL=ai:long
# Prefix of the branches ticks create, so pr_sweep.sh touches only the harness's own.
BRANCH_PREFIX=ai/
# The branch ticks merge into; empty skips keeping a base tree for it in worktree_gc.sh.
WORK_BRANCH=
# Worktree directory names worktree_gc.sh never removes, space-separated.
WORKTREE_KEEP=
# Seconds hooks/worktree-busy may take; past it, or on its failure, worktree_gc.sh removes nothing.
# WORKTREE_BUSY_TIMEOUT_S=30
# A base tree stays while its commit was WORK_BRANCH's head in the last KEEP_HOURS or is one of
# its last KEEP_HEADS heads: a long run can read it for hours after the branch moved.
# KEEP_HOURS=6
# KEEP_HEADS=3

# --- pool sizing ------------------------------------------------------------
# A project-aware queue count (bin/claimable.sh honours Depends on: and the labels above). A command
# line split on whitespace without quoting, so no path in it may contain a space.
QUEUE_DEPTH_CMD=$HARNESS_HOME/bin/claimable.sh
# Upper bound on concurrent ticks; the usage windows lower it (bin/usage-lib.sh).
MAX_SLOTS=4
# Width the usage steps scale from, when it should differ from MAX_SLOTS.
# TICK_WIDTH=4
# Seconds between spawning runners, so parallel ticks do not claim the same issue.
STAGGER_SECONDS=8
# Minimum seconds between heartbeat ticks while the queue is empty.
HEARTBEAT_INTERVAL=1800
# A tick shorter than this found nothing or failed, so its runner stops chaining.
CHAIN_MIN_TICK_S=180
# Most ticks one runner chains before it hands back to cron.
MAX_CHAIN=24
# A tick younger than this counts as about to claim a queued issue.
CLAIM_GRACE_S=360

# --- ticks ------------------------------------------------------------------
# Models in priority order; one that hits its usage limit is skipped for MODEL_COOLDOWN_S.
TICK_MODELS=claude-opus-5-5
# Seconds a model that hit its usage limit is skipped.
MODEL_COOLDOWN_S=1800
# A separate model for issues labelled LANE_LABEL; both empty turn the lane off.
LANE_MODEL=
LANE_LABEL=
# Minutes from claim to summary, stated in every claim.
TICK_BUDGET_MIN=60
# Minutes for an issue carrying LONG_LABEL.
LONG_TICK_BUDGET_MIN=120
# More names from this file exported to each tick, for the installation's prompt to use. The paths,
# GH_REPO, the labels and the PUBLIC_RECORD_* keys always are; GH_TOKEN never is.
TICK_EXPORTS=""
# Seconds hooks/hold may take before the harness treats it as not held.
HOLD_TIMEOUT_S=5

# --- usage telemetry --------------------------------------------------------
# JSON with timestamp, fiveHourPercent and weeklyPercent; missing or stale, nothing starts.
USAGE_CACHE=$HOME/.claude/usage-cache.json
# Refreshes USAGE_CACHE.
USAGE_FETCH=$HOME/.claude/scripts/usage-fetch.sh
# A reading older than this is unknown.
USAGE_MAX_AGE=1800
# A reading younger than this is not refreshed.
USAGE_REFRESH_AFTER=120
# Neither window may reach it.
USAGE_CEILING_PCT=90
# Where a running tick stands down; two under the ceiling unless set.
# USAGE_TICK_STOP_PCT=88
# The weekly window's stand-down point; USAGE_TICK_STOP_PCT unless set.
# USAGE_TICK_STOP_WEEK_PCT=88
# The 5-hour window halves the pool, keeps one tick, and starts none at these points.
FIVE_HALF_AT=60
FIVE_ONE_AT=70
FIVE_NONE_AT=80
# The weekly window's same three points; it fills slower, so they sit higher.
WEEK_HALF_AT=80
WEEK_ONE_AT=85
WEEK_NONE_AT=88

# --- runtime ----------------------------------------------------------------
# The CLI each tick runs.
CLAUDE_BIN=claude
# Ticks are unattended and cannot answer permission prompts.
CLAUDE_FLAGS=--dangerously-skip-permissions

# --- fleet (docs/FLEET.md) --------------------------------------------------
# 1 runs each tick through `fleet dispatch` instead of a local `claude -p`; CLAUDE_BIN and CLAUDE_FLAGS
# then do not apply, the device's fleetd.toml fixes the agent's command line.
FLEET_DISPATCH=
# The adapter each tick runs; anything but claude runs only through fleet.
TICK_AGENT=claude
# Executable names a tick runs as, space-separated: claim.sh and merge-lock.sh tie a claim to the
# nearest ancestor so named, and a claim lives while that process does. List every agent CLI used.
TICK_AGENT_EXES=claude
# The device a tick goes to; auto picks the least-loaded device with a free place for TICK_AGENT.
FLEET_DEVICE=auto
# The fleet CLI, a name looked up on HARNESS_PATH or a path.
FLEET_BIN=fleet
# The device registry; $HARNESS_INSTANCE_DIR/fleet.toml unless set.
# FLEET_CONFIG=/path/to/fleet.toml
# Seconds `tick.sh check` waits for `fleet status --json`.
# FLEET_CHECK_TIMEOUT_S=60
# PATH for cron, which starts with almost none.
HARNESS_PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
# Tick logs kept in $HARNESS_STATE/logs.
LOG_RETENTION=200
# Logs and locks; $HARNESS_HOME/state unless set.
# HARNESS_STATE=/path/to/state
# pr_sweep.sh's log; $HARNESS_STATE/logs/pr_sweep.log unless set.
# PR_SWEEP_LOG=/path/to/pr_sweep.log

# --- the public record ------------------------------------------------------
# Sections a PR body and an issue body must carry, comma-separated, matched as prefixes.
# PUBLIC_RECORD_PR_SECTIONS="Summary,Why,What changed,How to verify,Evidence,Scope and limits"
# PUBLIC_RECORD_ISSUE_SECTIONS="Summary,Ask"
# The installation's lint rules; $HARNESS_INSTANCE_DIR/lint_rules.json unless set.
# PUBLIC_RECORD_RULES=/path/to/lint_rules.json

# --- dashboard (every panel below is hidden while its keys are empty) -------
# Page title.
DASHBOARD_TITLE=
# Prints the shared-device status the resource panel shows, in the format docs/INSTANCE.md gives.
# The dashboard expands $HARNESS_HOME and $HARNESS_INSTANCE_DIR in this, DEVICE_PROBE_CMD and
# QUEUE_DEPTH_CMD, and nothing else.
RESOURCE_STATUS_CMD=
# Glob of run-queue directories, each with a status file.
RUN_QUEUE_GLOB=
# Process name that holds a run queue.
RUN_QUEUE_HOLDER=
# The queue log's file name in each run-queue directory; queue.log unless set.
RUN_QUEUE_LOG=
# Words in a queue's status that mean it stopped, space-separated.
RUN_QUEUE_STOP_WORDS=
# Split shell-style and run without a shell here; over ssh, as the same quoted words. Its first line
# is "<name>, <util %>, <memory used MiB>, <memory total MiB>", each further line a process on the
# device, "<pid>, <memory MiB>, <process name>" (nvidia-smi's csv,noheader,nounits form). A probe
# that needs pipes or several commands names its shell: sh -c '...'.
DEVICE_PROBE_CMD=
# Where the build locks live; /tmp unless set.
BUILD_LOCK_DIR=
# This host's build lock file name.
BUILD_LOCK_LOCAL=
# A remote host's build lock file name; {name} becomes the host's name below.
BUILD_LOCK_REMOTE=
# Each remote host's lock name, "<user@host>=<name> ...".
BUILD_LOCK_NAMES=
# Prints `fleet status --json`, read every 30 s for the Devices and Agent sessions panels. Split
# shell-style and run without a shell, like RESOURCE_STATUS_CMD.
FLEET_STATUS_CMD=
